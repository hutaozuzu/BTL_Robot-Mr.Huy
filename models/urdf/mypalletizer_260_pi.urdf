<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mypalletizer_260_pi">

  <link name="base">
    <visual>
      <geometry>
        <mesh filename="meshes/base.dae"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 3.1415926"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/base.dae"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 3.1415926"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <geometry>
        <mesh filename="meshes/link1.dae"/>
      </geometry>
      <origin xyz="0 -0.282 -0.115" rpy="1.5707963 0 -1.5707963"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/link1.dae"/>
      </geometry>
      <origin xyz="0 -0.282 -0.115" rpy="1.5707963 0 -1.5707963"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <link name="link2">
    <visual>
      <geometry>    
        <mesh filename="meshes/link2.dae"/>
      </geometry>
      <origin xyz="0 0.105 -0.414" rpy="0 1.5707963 3.1415926"/>
    </visual>
    <collision>
      <geometry>    
        <mesh filename="meshes/link2.dae"/>
      </geometry>
      <origin xyz="0 0.105 -0.414" rpy="0 1.5707963 3.1415926"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 -0.07 0" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <link name="link3">
    <visual>
      <geometry>
        <mesh filename="meshes/link3.dae"/>
      </geometry>
      <origin xyz="0 0.235 -0.325" rpy="0 1.5707963 3.1419626"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/link3.dae"/>
      </geometry>
      <origin xyz="0 0.235 -0.325" rpy="0 1.5707963 3.1419626"/>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0.06 -0.002 0" rpy="0 0 0"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <link name="link4">
    <visual>
      <geometry>
        <mesh filename="meshes/link4.dae"/>
      </geometry>
      <origin xyz="-0.12 -0.235 0.252" rpy="0 -1.5707963 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/link4.dae"/>
      </geometry>
      <origin xyz="-0.12 -0.235 0.252" rpy="0 -1.5707963 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="link5">
    <visual>
      <geometry>
        <cylinder length="0.015" radius="0.0152"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
      <origin xyz="0.044 -0.01 0.0" rpy="1.5707963267948966 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.015" radius="0.0152"/>
      </geometry>
      <origin xyz="0.044 -0.01 0.0" rpy="1.5707963267948966 0 0"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0.044 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="joint1_to_base" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.824" upper="2.824" velocity="0"/>
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>  
  </joint>

  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-0.0349" upper="1.5708" velocity="0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.0" rpy="-1.5707963267948966 0 0"/>  
  </joint>

  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-1.6057" upper="1.0471" velocity="0"/>
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.0 -0.14 0" rpy="0 0 0"/>  
  </joint>

  <joint name="joint4_to_joint3" type="fixed">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.134 0.0 0.0" rpy="3.141592653589793 0 0"/>  
  </joint>

  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-3.14" upper="3.14" velocity="0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0.0 0 0" rpy="0 0 0"/>  
  </joint>

</robot>
